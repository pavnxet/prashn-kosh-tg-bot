# ---------------------------------------------------------------------------
# Prashn-Kosh TG Bot — environment template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Telegram -------------------------------------------------------------
# From @BotFather.
BOT_TOKEN=123456789:REPLACE_WITH_BOTFATHER_TOKEN
# Your personal Telegram numeric user id (the bot owner). Use @userinfobot to find it.
OWNER_TG_ID=123456789

# --- Turso (same DB as the prashn-kosh web app) ---------------------------
# The bot only READS questions/subjects/topics and WRITES its own bot_* tables.
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=eyJhbGciOi...REPLACE_ME

# --- Behaviour ------------------------------------------------------------
DEFAULT_TZ=Asia/Kolkata
LOG_LEVEL=info
# Bot menu/help language: en | hi (default en).
MENU_LANG=en
# Safety default: true = never call Telegram send methods (log the intended send instead).
DRY_RUN=true

# --- Scheduler (Phase 4) ---------------------------------------------------
# The daily-posting engine. Every value below has a safe default, so this block
# can stay out of `.env` entirely.
# false = park the engine without touching any stored schedule.
SCHEDULER_ENABLED=true
# How often to check for due slots, in seconds (5-3600).
SCHEDULER_TICK_SECONDS=60
# A slot that is reached after <n> minutes is skipped, never replayed (0-1440).
# Keeps a restart at 4 pm from dumping the 8 am batch into the channel.
SCHEDULE_CATCHUP_MINUTES=60
# The slot `/schedule default` (and a fresh `/connect`) creates, 24-hour HH:MM
# in the channel's timezone.
DEFAULT_SCHEDULE_TIME=08:00
# How many questions that default slot posts (1-30).
DEFAULT_SCHEDULE_COUNT=10
